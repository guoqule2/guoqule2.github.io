<?xml version="1.0" encoding="UTF-8"?>
<!--
  Archetype 清单：IDEA 通过 Catalog URL 读这个文件，就能在下拉框里列出可用脚手架。

  访问地址（同一份文件，两处托管）：
    GitHub Pages（公开，给他人用）：https://guoqule2.github.io/archetype-catalog.xml
    本地 Nginx（调试用）：          http://localhost/archetype-catalog.xml

  jar 本体位置（org/example/ai-agent-base-archetype/<version>/）：
    GitHub Pages：https://guoqule2.github.io/  —— 公开可读，settings.xml 里加 guoqule2-pages profile 即可
    阿里云云效：  私有仓库，需 rdc profile 的地址与账号
-->
<archetype-catalog xsi:schemaLocation="http://maven.apache.org/plugins/maven-archetype-plugin/archetype-catalog/1.0.0 http://maven.apache.org/xsd/archetype-catalog-1.0.0.xsd"
    xmlns="http://maven.apache.org/plugins/maven-archetype-plugin/archetype-catalog/1.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <archetypes>

        <!-- 本项目的脚手架：六模块 DDD 分层（api / app / domain / trigger / infrastructure / types）
             1.0.3：① 模块依赖 groupId 参数化 ${groupId}  ② dependencyManagement 版本参数化 ${version}
                    ③ 清除模板内硬编码的百度 MCP 密钥，改为 ${BAIDU_MCP_API_KEY} / ${BAIDU_MAP_AK}
                    ④ developers 改为本人信息 -->
        <archetype>
            <groupId>org.example</groupId>
            <artifactId>ai-agent-base-archetype</artifactId>
            <version>1.0.3</version>
            <description>AI Agent 工程底座：六模块 + ADK 装配链 + Spring AI 多模态补丁</description>
        </archetype>

        <!--
          以后发布新版本时，在这里追加一条即可（旧条目保留，IDEA 会显示多个可选版本）：
          <archetype>
              <groupId>org.example</groupId>
              <artifactId>ai-agent-base-archetype</artifactId>
              <version>1.1.0</version>
              <description>同上，新增 xxx</description>
          </archetype>
        -->

    </archetypes>
</archetype-catalog>
